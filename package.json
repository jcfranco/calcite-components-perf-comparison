{
  "name": "calcite-table-performance",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "vite",
    "start:local": "CALCITE_BUILD=local vite --port 4174",
    "start:latest": "CALCITE_BUILD=latest vite --port 4173",
    "compare": "node scripts/compare.js",
    "setup:latest": "npm install --prefix .benchmark/latest --no-save @esri/calcite-components@latest",
    "build": "vite build",
    "build:local": "CALCITE_BUILD=local vite build --outDir dist/local",
    "build:latest": "CALCITE_BUILD=latest vite build --outDir dist/latest",
    "preview": "vite preview"
  },
  "devDependencies": {
    "vite": "^7.1.3"
  },
  "dependencies": {
    "@esri/calcite-components": "^5.1.2"
  }
}
